# Use Python 3.9 as base image
FROM python:3.9-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    software-properties-common \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install additional dependencies for graph processing
RUN pip install --no-cache-dir \
    torch==2.1.2 \
    transformers==4.36.2 \
    sentence-transformers==2.2.2

# Copy the application code
COPY . .

# Create cache directory for embeddings
RUN mkdir -p .cache/embeddings && chmod 777 .cache/embeddings

# Create config directory if it doesn't exist
RUN mkdir -p config

# Copy default config if not mounted
COPY config/default_config.yaml config/config.yaml

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Expose the port the app runs on
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Command to run the application
CMD ["uvicorn", "src.api.server:app", "--host", "0.0.0.0", "--port", "5000", "--reload"]
